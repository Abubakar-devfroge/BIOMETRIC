<Layouts.flash_group flash={@flash} />
<%= if @current_user do %>
  <h1 class="text-2xl font-bold text-base-content mb-4">Welcome back {@current_user.email}</h1>

  <div class="card bg-base-100 shadow-xl col-span-12 sm:col-span-6">
    <div class="card-body flex-row justify-between items-center p-4">
      <div>
        <p class="card-title text-base font-semibold text-base-content m-0">
          ATTENDANCE DATA
        </p>
      </div>

      <div>
        <a
          href={~p"/employees"}
          class="btn btn-outline btn-sm btn-primary"
        >
          View Reports
        </a>
      </div>
    </div>
  </div>
<% else %>
  <%!-- hero --%>
  <section class="relative overflow-hidden bg-base-100 text-base-content">
    <div class="overflow-x-hidden">
      <div class="pt-10 pb-8 md:pb-8 lg:pt-10 lg:pb-8">
        <div class="relative mx-auto flex max-w-6xl flex-col px-6 lg:flex-row lg:items-center">
          <div class="w-full text-left lg:ml-0 lg:w-1/2">
            <h1 class="mt-4 text-4xl leading-tight font-medium sm:text-5xl md:text-6xl xl:text-7xl text-base-content">
              Grow Smarter Work Faster
            </h1>
          </div>

          <div class="relative mt-8 w-full lg:mt-0 lg:w-1/2">
            <div class="absolute inset-0 rounded-xl bg-neutral/30 mix-blend-overlay" />
            <div class="h-75 overflow-hidden rounded-xl sm:h-100 md:h-125 lg:h-auto">
              <img
                class="h-full w-full object-cover object-center"
                src={~p"/images/work.png"}
                alt="Hero Image"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- Footer --%>
  <footer class="bg-base-100 text-base-content/70 ">
    <div class="mx-auto max-w-7xl px-6 py-12 grid grid-cols-1 gap-10 sm:grid-cols-2 md:grid-cols-5">
      <aside class="md:col-span-2 space-y-4">
        <span class="text-4xl tracking-tight text-base-content font-extrabold mb-4">
          <a href={~p"/"} class="flex items-center gap-1">
            <img
              src={~p"/images/logos.png"}
              alt="Swiftly logo"
              class="h-10 w-auto"
              width="299"
              height="224"
              decoding="async"
              fetchpriority="high"
              oncontextmenu="return false;"
            />
          </a>
        </span>

        <p class="text-sm leading-relaxed text-base-content/80">
          <br /> Clock. Track. Manage.
        </p>
      </aside>

      <nav class="space-y-3">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-base-content">Company</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="https://www.craftinc.dev/"
              target="_blank"
              rel="noopener noreferrer"
              class="link link-hover text-base-content/80 hover:text-primary transition-colors"
            >
              About us
            </a>
          </li>
          <li>
            <a
              href="https://www.craftinc.dev/"
              target="_blank"
              rel="noopener noreferrer"
              class="link link-hover text-base-content/80 hover:text-primary transition-colors"
            >
              Blog
            </a>
          </li>
        </ul>
      </nav>

      <nav class="space-y-3">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-base-content">Legal</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="https://www.craftinc.dev/Privacy"
              target="_blank"
              rel="noopener noreferrer"
              class="link link-hover text-base-content/80 hover:text-primary transition-colors"
            >
              Terms of use
            </a>
          </li>
          <li>
            <a
              href="https://www.craftinc.dev/Privacy"
              target="_blank"
              rel="noopener noreferrer"
              class="link link-hover text-base-content/80 hover:text-primary transition-colors"
            >
              Privacy policy
            </a>
          </li>
        </ul>
      </nav>

      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <Layouts.theme_toggle />
        </div>
      </div>
    </div>
  </footer>
<% end %>
